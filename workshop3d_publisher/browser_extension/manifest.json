{
  "manifest_version": 3,
  "name": "WorkShop3D — sparowany Chrome",
  "version": "0.5.1",
  "description": "Łączy lokalny panel WorkShop3D z zalogowanymi kartami sklepów 3D.",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://cults3d.com/*",
    "https://thangs.com/*",
    "https://www.crealitycloud.com/*",
    "https://www.crealitycloud.cn/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.pinterest.com/*",
    "https://pinterest.com/*",
    "https://bsky.app/*",
    "https://mastodon.social/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Otwórz WorkShop3D Publisher"
  },
  "options_page": "options.html"
}
