{
  "manifest_version": 3,
  "name": "WorkShop3D — sparowany Chrome",
  "version": "0.2.1",
  "description": "Łączy lokalny panel WorkShop3D z zalogowanymi kartami sklepów 3D.",
  "permissions": ["alarms", "notifications", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://cults3d.com/*",
    "https://thangs.com/*",
    "https://www.crealitycloud.com/*",
    "https://www.crealitycloud.cn/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "WorkShop3D — ustawienia połączenia"
  },
  "options_page": "options.html"
}
